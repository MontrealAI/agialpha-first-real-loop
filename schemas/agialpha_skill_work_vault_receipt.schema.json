{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/agialpha_skill_work_vault_receipt.schema.json",
  "title": "AGI ALPHA Skill Work Vault Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "receipt_id",
    "skill_id",
    "source_job_id",
    "source_agent_id",
    "target_agent_ids",
    "utility_budget_units",
    "alpha_work_units_estimated",
    "validator_fee_units",
    "replay_fee_units",
    "proofbundle_fee_units",
    "evidence_docket_fee_units",
    "skill_publication_fee_units",
    "skill_import_fee_units",
    "unused_budget_refund_units",
    "settlement_mode",
    "wallet_used",
    "custody_used",
    "payment_executed",
    "token_price_used",
    "investment_claim_made",
    "receipt_note"
  ],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string", "minLength": 1},
    "source_job_id": {"type": "string", "minLength": 1},
    "source_agent_id": {"type": "string", "minLength": 1},
    "target_agent_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "utility_budget_units": {"type": "number", "minimum": 0},
    "alpha_work_units_estimated": {"type": "number", "minimum": 0},
    "validator_fee_units": {"type": "number", "minimum": 0},
    "replay_fee_units": {"type": "number", "minimum": 0},
    "proofbundle_fee_units": {"type": "number", "minimum": 0},
    "evidence_docket_fee_units": {"type": "number", "minimum": 0},
    "skill_publication_fee_units": {"type": "number", "minimum": 0},
    "skill_import_fee_units": {"type": "number", "minimum": 0},
    "unused_budget_refund_units": {"type": "number", "minimum": 0},
    "settlement_mode": {"type": "string", "const": "synthetic_local_json_receipt_only"},
    "wallet_used": {"type": "boolean", "const": false},
    "custody_used": {"type": "boolean", "const": false},
    "payment_executed": {"type": "boolean", "const": false},
    "token_price_used": {"type": "boolean", "const": false},
    "investment_claim_made": {"type": "boolean", "const": false},
    "receipt_note": {"type": "string", "minLength": 1}
  }
}
